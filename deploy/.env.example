# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared) ile alınan token
TUNNEL_TOKEN=
# Oyunun açılacağı adres, ör. https://oyun.ornek.com
PUBLIC_ORIGIN=
# Google / Apple girişinin Firebase projeleri: her mobil uygulamanın kendi projesi (virgülle)
FIREBASE_PROJECT_IDS=songie-app,itiraf-kosesi-app,casebook-monolith,weknows-app
# Bunun altındaki mobil uygulama sürümleri "güncelle" ekranı gösterir
MIN_APP_VERSION=1.0.0
# Davet linklerinin uygulamada açılması (boşsa kapalı): Apple Developer Team ID
APPLE_TEAM_ID=
# Android yayın imzasının SHA-256 parmak izi (AA:BB:…, virgülle birden çok)
ANDROID_CERT_SHA256=
